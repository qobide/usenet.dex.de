{
  "name": "usenet.dex.de",
  "homepage": "http://usenet.dex.de/",
  "version": "1.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host=0.0.0.0",
    "build": "ng build",
    "deploy_stage": "ng build --configuration staging    && rsync -rptvz --delete dist/next/browser/ $npm_config_staging_path",
    "deploy": "ng build --configuration production && rsync -rptvz --delete dist/next/browser/ $npm_config_production_path",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/aria": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "~21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "echarts": "^6.0.0",
    "ngx-echarts": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/material": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^26.0.1",
    "angular-eslint": "21.3.1",
    "eslint": "^10.0.3",
    "jasmine-core": "^6.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.56.1"
  }
}
