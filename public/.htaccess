RewriteEngine on

RewriteRule ^(de\..*\.ALL)\.html$ /hierarchy/$1 [R=permanent,L]
RewriteRule ^(de\..*)\.html$      /newsgroup/$1 [R=permanent,L]
RewriteRule ^atoz\.html$          /atoz         [R=permanent,L]

RewriteCond %{REQUEST_FILENAME} -s [OR]
RewriteCond %{REQUEST_FILENAME} -l [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.*$ - [NC,L]

RewriteRule ^(.*) ./index.html [NC,L]
